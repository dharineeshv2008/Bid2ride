# Application Mode
ENVIRONMENT=development
DEBUG=true

# Development Mode: bypasses OTP/SMS. Demo users auto-login with phone number.
DEVELOPMENT_MODE=false
DEV_ADMIN_PASSWORD=admin123

# Security Tokens
SECRET_KEY=change-this-super-secret-key-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase PostgreSQL Database
# Set DATABASE_URL to the full Supabase connection string (with sslmode=require).
# If DATABASE_URL is empty, individual POSTGRES_* fields below are used.
DATABASE_URL=

# Supabase API Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Individual PostgreSQL fields (fallback when DATABASE_URL is not set)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bid2ride_user
POSTGRES_PASSWORD=bid2ride_password
POSTGRES_DB=bid2ride_db

# Redis Caching Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OSRM Maps Routing
OSRM_SERVER_URL=http://router.project-osrm.org
