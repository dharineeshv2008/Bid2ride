# =====================================================================
# Bid2Ride - Production Environment Configuration Template (Supabase)
# Copy this file to .env on the production host and fill in secrets
# =====================================================================

ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=Bid2Ride

# Development Mode (MUST be false in production - enables OTP bypass demo logins)
DEVELOPMENT_MODE=false
DEV_ADMIN_PASSWORD=admin123

# Cryptographic Signatures (Must be 32+ characters long)
SECRET_KEY=change_this_to_a_secure_long_cryptographic_secret_hash_key_1234
ALGORITHM=HS256

# Supabase PostgreSQL Database
# Full connection string for Supabase (includes password, host, port, sslmode)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase API Configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Redis clusters configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_production_password_value_here

# Mock Credentials (replace with real if production integrations exist)
STRIPE_SECRET_KEY=sk_prod_stripe_keys_here
STRIPE_WEBHOOK_SECRET=whsec_stripe_webhooks_secret_here

TWILIO_ACCOUNT_SID=AC_twilio_account_sid_here
TWILIO_AUTH_TOKEN=twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15550100
